/* DialogueGraphStyles.uss - Unity Navigation-style graph editor */

/* Graph View Container */
.graph-view-pane {
    flex-grow: 1;
    background-color: #393939;
    /*min-width: 300px;*/
}

/* Toolbar */
.toolbar {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    height: 32px;
    background-color: #383838;
    border-color: #212121;
    border-width: 1px;
    border-radius: 4px;
    flex-direction: row;
    align-items: center;
    padding: 0 8px;
}

.toolbar-title {
    flex-grow: 1;
    color: #FFFFFF;
    font-size: 12px;
    -unity-font-style: bold;
}

.toolbar-button {
    background-color: #4A90E2;
    border-color: #357ABD;
    color: white;
    padding: 4px 8px;
    border-radius: 2px;
    border-width: 1px;
    font-size: 14px;
    margin-left: 4px;
}

.toolbar-button:hover {
    background-color: #357ABD;
}

/* Node Styles */
.node {
    min-width: 200px;
    max-width: 300px;
}

.speech-node {
    border-color: #000000;
    border-width: 2px;
}

.speech-node > .node-border {
    border-color: #000000;
    border-width: 2px;
}

.speech-node .description-label {
    background-color: #000000;
    color: white;
    font-size: 14px;
}

.choice-node {
    border-color: #267FCC;
    border-width: 2px;
}

.choice-node > .node-border {
    border-color: #267FCC;
    border-width: 2px;
}

.choice-node .description-label {
    background-color: #267FCC;
    color: white;
    font-size: 14px;
}

.function-node {
    border-color: #4c9051;
    border-width: 2px;
}

.function-node > .node-border {
    border-color: #4c9051;
    border-width: 2px;
}

.function-node .description-label {
    background-color: #4c9051;
    color: white;
    font-size: 14px;
}

.conditional-node {
    border-color: #4CAF50;
    border-width: 2px;
}

.conditional-node > .node-border {
    border-color: #4CAF50;
    border-width: 2px;
}

.conditional-node .description-label {
    background-color: #4CAF50;
    color: white;
    font-size: 14px;
}

.variable-set-node {
    border-color: #FF9800;
    border-width: 2px;
}

.variable-set-node > .node-border {
    border-color: #FF9800;
    border-width: 2px;
}

.variable-set-node .description-label {
    background-color: #FF9800;
    color: white;
    font-size: 14px;
}

.start-node {
    border-color: #7a33ff;
    border-width: 3px;
}

.start-node > .node-border {
    border-color: #7a33ff;
    border-width: 3px;
}

.start-node .description-label {
    background-color: #7a33ff;
    color: white;
    -unity-font-style: bold;
}

/* Description Container */
.description-container {
    position: absolute;
    top: -28px;
    left: 5px;
    right: 0;
    height: 18px;
    align-items: flex-start;
    justify-content: center;
}

.description-label {
    background-color: #555555;
    color: white;
    font-size: 10px;
    padding: 2px 8px;
    border-radius: 9px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}

/* Inspector Container */
.inspector-container {
    padding: 8px;
    background-color: #2B2B2B;
    border-radius: 4px;
    margin: 4px 0;
}

.inspector-container > .unity-property-field {
    margin-bottom: 4px;
}

.inspector-container > .unity-property-field > .unity-label {
    min-width: 80px;
    font-size: 14px;
    color: #CCCCCC;
    visibility: hidden;
}

.inspector-container > .unity-property-field > .unity-text-field {
    flex-grow: 1;
}

.inspector-container > .unity-property-field > .unity-text-field > .unity-text-field__input {
    background-color: #383838;
    border-color: #555555;
    color: #FFFFFF;
    font-size: 11px;
}

/* Port Styles */
.port {
    height: 16px;
    align-items: center;
}

.port > .type {
    background-color: #4A90E2;
    border-color: #357ABD;
    border-width: 2px;
    border-radius: 8px;
    width: 16px;
    height: 16px;
}

.port.input > .type {
    background-color: #27AE60;
    border-color: #1E8449;
}

.port.output > .type {
    background-color: #F39C12;
    border-color: #D68910;
}

.port > .connector {
    background-color: #4A90E2;
    border-color: #357ABD;
    border-width: 2px;
    border-radius: 8px;
    width: 16px;
    height: 16px;
}

.port.input > .connector {
    background-color: #27AE60;
    border-color: #1E8449;
}

.port.output > .connector {
    background-color: #F39C12;
    border-color: #D68910;
}

/* Edge Styles */
.edge {
    --edge-width: 2px;
    --edge-color: #F39C12;
}

.edge:hover {
    --edge-color: #D68910;
    --edge-width: 3px;
}

.edge.selected {
    --edge-color: #FFFFFF;
    --edge-width: 3px;
}

/* Grid Background */
GridBackground {
    --grid-background-color: #2B2B2B;
    --line-color: rgba(255, 255, 255, 0.1);
    --thick-line-color: rgba(255, 255, 255, 0.15);
    --spacing: 50;
}

/* Selection Styles */
.node.selected {
    border-color: #FFFFFF;
    border-width: 3px;
}

.node.selected > .node-border {
    border-color: #FFFFFF;
    border-width: 3px;
}

/* Title Container */
.node .title-container {
    background-color: #383838;
    border-bottom-color: #555555;
    border-bottom-width: 1px;
    padding: 4px 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

#title-label {
    visibility: hidden;
}

.node .title-label {
    color: #FFFFFF;
    font-size: 12px;
    -unity-font-style: bold;
}

/* Extension Container */
.node .extension-container {
    background-color: #2B2B2B;
    padding: 0;
}

/* Input/Output Containers */
.node .input-container {
    background-color: #2B2B2B;
    padding: 4px 0;
}

.node .output-container {
    background-color: #2B2B2B;
    padding: 4px 0;
}

/* Minimap */
.minimap {
    position: absolute;
    bottom: 16px;
    right: 16px;
    width: 200px;
    height: 140px;
    background-color: rgba(56, 56, 56, 0.8);
    border-color: #555555;
    border-width: 1px;
    border-radius: 4px;
}

/* Context Menu */
.context-menu {
    background-color: #383838;
    border-color: #555555;
    border-width: 1px;
    border-radius: 4px;
    padding: 4px 0;
}

.context-menu-item {
    padding: 4px 16px;
    color: #FFFFFF;
    font-size: 12px;
}

.context-menu-item:hover {
    background-color: #4A90E2;
}

/* Search Window */
.search-window {
    background-color: #383838;
    border-color: #555555;
    border-width: 1px;
    border-radius: 4px;
    padding: 8px;
    min-width: 200px;
}

.search-window-input {
    background-color: #2B2B2B;
    border-color: #555555;
    border-width: 1px;
    border-radius: 2px;
    color: #FFFFFF;
    padding: 4px;
    margin-bottom: 8px;
}

/* Blackboard (if needed for variables) */
.blackboard {
    position: absolute;
    top: 50px;
    left: 16px;
    min-width: 200px;
    background-color: rgba(56, 56, 56, 0.9);
    border-color: #555555;
    border-width: 1px;
    border-radius: 4px;
    padding: 8px;
}

.blackboard-header {
    background-color: #4A90E2;
    color: white;
    padding: 4px 8px;
    margin: -8px -8px 8px -8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-size: 12px;
    -unity-font-style: bold;
}

/* Inspector Pane */
.inspector-pane {
    background-color: #383838;
    border-left-width: 1px;
    border-left-color: #212121;
    flex-direction: column;
    min-width: 200px;
    flex-shrink: 0;
}

.inspector-header {
    background-color: #2B2B2B;
    padding: 8px 12px;
    border-bottom-width: 1px;
    border-bottom-color: #212121;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.inspector-header-label {
    color: #FFFFFF;
    font-size: 14px;
    -unity-font-style: bold;
}

.inspector-scroll-view {
    flex-grow: 1;
}

.inspector-content {
    padding: 12px;
    flex-direction: column;
}

/* Section Headers */
.inspector-section-header {
    color: #4A90E2;
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 16px;
    margin-bottom: 8px;
    padding-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: #4A90E2;
}

/*.inspector-section-header:first-child {*/
/*    margin-top: 0;*/
/*}*/

/* Form Fields */
.inspector-field {
    margin-bottom: 8px;
}

.inspector-field > .unity-label {
    color: #CCCCCC;
    font-size: 11px;
    min-width: 80px;
    margin-bottom: 2px;
}

.inspector-field > .unity-text-field > .unity-text-field__input {
    background-color: #2B2B2B;
    border-color: #555555;
    border-width: 1px;
    border-radius: 2px;
    color: #FFFFFF;
    padding: 4px 6px;
    font-size: 11px;
}

.inspector-field > .unity-text-field > .unity-text-field__input:focus {
    border-color: #4A90E2;
    border-width: 2px;
}

.inspector-field-label {
    color: #CCCCCC;
    font-size: 11px;
    margin-bottom: 4px;
    margin-top: 8px;
}

/* Text Areas */
.inspector-text-area {
    min-height: 80px;
}

.inspector-text-area > .unity-text-field__input {
    white-space: normal;
    -unity-text-align: upper-left;
    padding: 6px;
}

/* Info Labels */
.inspector-info-label {
    color: #AAAAAA;
    font-size: 10px;
    margin: 2px 0;
    padding: 2px 0;
}

.inspector-help-label {
    color: #888888;
    font-size: 12px;
    margin: 20px 0;
    -unity-text-align: middle-center;
    white-space: normal;
}

.inspector-node-id {
    background-color: #2B2B2B;
    padding: 2px 4px;
    border-radius: 2px;
    font-size: 9px;
}

/* Choices Section */
.inspector-choices-container {
    flex-direction: column;
    margin-top: 8px;
}

.inspector-choice-item {
    flex-direction: column;
    background-color: #2B2B2B;
    border-radius: 4px;
    padding: 8px;
    margin-bottom: 8px;
    border-width: 1px;
    border-color: #555555;
}

.inspector-choice-item > .inspector-field {
    margin-bottom: 4px;
}

/* Buttons */
.inspector-add-button {
    background-color: #27AE60;
    border-color: #1E8449;
    color: white;
    padding: 6px 12px;
    border-radius: 4px;
    border-width: 1px;
    margin-top: 8px;
    font-size: 11px;
}

.inspector-add-button:hover {
    background-color: #1E8449;
}

.inspector-remove-button {
    background-color: #E74C3C;
    border-color: #C0392B;
    color: white;
    padding: 4px 8px;
    border-radius: 2px;
    border-width: 1px;
    margin-top: 4px;
    font-size: 10px;
    align-self: flex-end;
}

.inspector-remove-button:hover {
    background-color: #C0392B;
}

/* Enhanced Split View Styles for Unity 6 */
.unity-two-pane-split-view {
    flex-direction: row;
}

.unity-two-pane-split-view__dragline {
    background-color: #212121;
    width: 1px;
    position: relative;
    cursor: resize-horizontal;
}

.unity-two-pane-split-view__dragline:hover {
    background-color: #4A90E2;
    width: 2px;
}

.unity-two-pane-split-view__dragline-anchor {
    background-color: transparent;
    width: 4px;
    /*position: absolute;*/
    top: 0;
    bottom: 0;
    cursor: resize-horizontal;
    border-radius: 0;
}

.unity-two-pane-split-view__dragline-anchor:hover {
    background-color: rgba(74, 144, 226, 0.3);
}

.unity-two-pane-split-view__dragline-anchor:active {
    background-color: rgba(74, 144, 226, 0.5);
}

/* Fix for split view pane positioning */
/*.unity-two-pane-split-view > .unity-two-pane-split-view__content-container {*/
/*    flex-direction: row;*/
/*    flex-grow: 1;*/
/*}*/

