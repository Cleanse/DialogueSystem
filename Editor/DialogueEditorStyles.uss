/*    flex-grow: 1;*/
/*    flex-shrink: 1;*/
/*    min-width: 300px;*/
/*}*/

/*.unity-two-pane-split-view > .unity-two-pane-split-view__content-container > .unity-two-pane-split-view__right-pane {*/
/*    flex-grow: 0;*/
/*    flex-shrink: 0;*/
/*    width: auto;*/
/*    min-width: 200px;*/
/*}*/

/* Dark Theme Enhancements */
.inspector-field > .unity-text-field > .unity-text-field__input:disabled {
    background-color: #1E1E1E;
    color: #666666;
}

.inspector-section-header.secondary {
    color: #F39C12;
    border-bottom-color: #F39C12;
}

.inspector-section-header.warning {
    color: #E74C3C;
    border-bottom-color: #E74C3C;
}

/* Animation for smooth interactions */
.inspector-choice-item {
    transition: background-color 0.2s ease;
}

.inspector-choice-item:hover {
    background-color: #333333;
}

/* Additional fixes for Unity 6 TwoPaneSplitView */
.unity-two-pane-split-view__dragline-ghost {
    background-color: #4A90E2;
    opacity: 0.7;
}

/* Ensure proper cursor display */
.unity-two-pane-split-view__dragline,
.unity-two-pane-split-view__dragline-anchor {
    cursor: resize-horizontal;
}

/* Fix any overflow issues */
.unity-two-pane-split-view__content-container {
    overflow: hidden;
}

.unity-two-pane-split-view__left-pane,
.unity-two-pane-split-view__right-pane {
    overflow: hidden;
}

/* Hide input ports on start nodes */
.start-node .input-container {
    display: none;
}

/* Speaker Name field visibility classes */
.speaker-name-field {
    transition: opacity 0.3s ease, max-height 0.3s ease;
    overflow: hidden;
    max-height: 100px;
    opacity: 1;
}

.speaker-name-field.hidden {
    opacity: 0;
    max-height: 0;
    margin-bottom: 0;
}

/* When character database is populated, hide speaker name fields */
.character-database-active .speaker-name-field {
    opacity: 0;
    max-height: 0;
    margin-bottom: 0;
}